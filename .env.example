# Integraciones de la web (ver AGENDA.md). Copia este archivo a .env.local y llena lo que tengas.
# Nunca subas .env.local a git. Todo es opcional: lo que falte se desactiva o cae a WhatsApp.

# ---------------------------------------------------------------- Sitio
# Dominio público, sin barra final (enlaces en correos, Open Graph y sitemap)
NEXT_PUBLIC_SITE_URL=https://www.tu-dominio.com

# ---------------------------------------------------------------- Google (agenda, fotos, panel)
# Opción A (recomendada): OAuth con la cuenta de Diana → Calendar + fotos en su Drive
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Opción B: cuenta de servicio → solo Calendar (Drive únicamente con unidad compartida de Workspace)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Calendario de Diana (para el principal, su correo de Gmail)
GOOGLE_CALENDAR_ID=
# Carpeta de Drive donde se guardan las fotos de las clientas (el ID está en la URL de la carpeta)
GOOGLE_DRIVE_FOLDER_ID=

# ---------------------------------------------------------------- Panel de Diana (/diana)
DIANA_PANEL_PASSWORD=

# ---------------------------------------------------------------- Correo (Resend)
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend, p. ej. Diana Melo <citas@tu-dominio.com>
RESEND_FROM=
# A dónde le llegan a Diana los avisos de nuevas citas y lista de espera
DIANA_EMAIL=

# ---------------------------------------------------------------- WhatsApp automático (Meta, WhatsApp Business)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nombres de plantillas aprobadas por Meta, con 2 variables: {{1}} nombre, {{2}} fecha y hora
WHATSAPP_TEMPLATE_CONFIRMACION=
WHATSAPP_TEMPLATE_RECORDATORIO=
WHATSAPP_TEMPLATE_LANG=es

# ---------------------------------------------------------------- Recordatorios diarios (Vercel Cron)
# Cadena larga y aleatoria; Vercel la envía sola al cron de vercel.json
CRON_SECRET=

# ---------------------------------------------------------------- Reseñas de Google (Places API)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ---------------------------------------------------------------- Métricas sin datos personales (Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
